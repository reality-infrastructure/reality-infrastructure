{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "worker output (TODO)",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "confidence"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "finding", "citations"],
        "properties": {
          "id": {"type": "string"},
          "finding": {"type": "string"},
          "value": {"type": ["number", "string", "null"], "traceable": true},
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ref"],
              "properties": {"ref": {"type": "string"}, "field": {"type": "string"}}
            }
          }
        }
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
