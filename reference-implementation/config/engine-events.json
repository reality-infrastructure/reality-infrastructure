{
  "verdict": {
    "type": "object",
    "additionalProperties": false,
    "required": ["run_id", "agent", "verdict", "reason"],
    "properties": {
      "run_id": {"type": "string"},
      "agent": {"type": "string"},
      "verdict": {"type": "string", "enum": ["followed", "overridden", "wrong", "n/a"]},
      "reason": {"type": "string"}
    }
  },
  "drift": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "shifted", "why", "measured"],
    "properties": {
      "id": {"type": "string"},
      "shifted": {"type": "boolean"},
      "why": {"type": "string"},
      "measured": {"type": "object"}
    }
  },
  "honeypot": {
    "type": "object",
    "additionalProperties": false,
    "required": ["target_run_id", "judge_run_id", "path", "hit", "verdict"],
    "properties": {
      "target_run_id": {"type": "string"},
      "judge_run_id": {"type": "string"},
      "path": {"type": "string"},
      "hit": {"type": "boolean"},
      "verdict": {"type": ["string", "null"]}
    }
  },
  "refinement": {
    "type": "object",
    "additionalProperties": false,
    "required": ["agent", "rung", "file", "old_sha256", "new_sha256", "before_score", "after_score", "adopted", "refiner_run_id", "why"],
    "properties": {
      "agent": {"type": "string"},
      "rung": {"type": "integer", "minimum": 1, "maximum": 2},
      "file": {"type": "string"},
      "old_sha256": {"type": "string"},
      "new_sha256": {"type": "string"},
      "before_score": {"type": "string"},
      "after_score": {"type": "string"},
      "adopted": {"type": "boolean"},
      "refiner_run_id": {"type": "string"},
      "why": {"type": "string"},
      "before_holdout": {"type": ["string", "null"]},
      "after_holdout": {"type": ["string", "null"]},
      "objective_hash": {"type": "string"},
      "samples": {"type": "integer", "minimum": 1},
      "before_pass_at_k": {"type": "string"},
      "after_pass_at_k": {"type": "string"},
      "before_interval": {"type": "object"},
      "after_interval": {"type": "object"},
      "before_strata": {"type": "object"},
      "after_strata": {"type": "object"},
      "refusals": {"type": "array", "items": {"type": "string"}}
    }
  },
  "correction": {
    "type": "object",
    "additionalProperties": false,
    "required": ["corrects_event_id", "reason", "payload"],
    "properties": {
      "corrects_event_id": {"type": "string"},
      "reason": {"type": "string"},
      "payload": {"type": "object"}
    }
  },
  "command_blocked": {
    "type": "object",
    "additionalProperties": false,
    "required": ["slot", "adapter", "command", "reason"],
    "properties": {
      "slot": {"type": "string"},
      "adapter": {"type": "string"},
      "command": {"type": "object"},
      "reason": {"type": "string"}
    }
  },
  "latency_breach": {
    "type": "object",
    "additionalProperties": false,
    "required": ["slot", "adapter", "event_id", "latency_seconds", "sla_seconds"],
    "properties": {
      "slot": {"type": "string"},
      "adapter": {"type": "string"},
      "event_id": {"type": "string"},
      "latency_seconds": {"type": "number"},
      "sla_seconds": {"type": "number"}
    }
  },
  "compaction.summary": {
    "type": "object",
    "additionalProperties": false,
    "required": ["agent", "summary", "range", "citations"],
    "properties": {
      "agent": {"type": "string"},
      "summary": {"type": "string"},
      "range": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_observed_at", "to_observed_at", "event_count"],
        "properties": {
          "from_observed_at": {"type": "string"},
          "to_observed_at": {"type": "string"},
          "event_count": {"type": "integer", "minimum": 1}
        }
      },
      "citations": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref"],
          "properties": {"ref": {"type": "string"}, "field": {"type": "string"}}
        }
      }
    }
  },
  "eval_integrity": {
    "type": "object",
    "additionalProperties": false,
    "required": ["agent", "golden_file", "controls_failed_as_expected", "controls_passed", "golden_cases_rejected_by_checks"],
    "properties": {
      "agent": {"type": "string"},
      "golden_file": {"type": "string"},
      "controls_failed_as_expected": {"type": "array", "items": {"type": "string"}},
      "controls_passed": {"type": "array", "items": {"type": "string"}},
      "golden_cases_rejected_by_checks": {"type": "array", "items": {"type": "object"}}
    }
  },
  "suspect_case": {
    "type": "object",
    "additionalProperties": false,
    "required": ["agent", "golden_file", "case_id", "reason", "cleared"],
    "properties": {
      "agent": {"type": "string"},
      "golden_file": {"type": "string"},
      "case_id": {"type": "string"},
      "reason": {"type": "string"},
      "cleared": {"type": "boolean"}
    }
  },
  "objective": {
    "type": "object",
    "additionalProperties": false,
    "required": ["agent", "old_hash", "new_hash", "why"],
    "properties": {
      "agent": {"type": "string"},
      "old_hash": {"type": ["string", "null"]},
      "new_hash": {"type": "string"},
      "why": {"type": "string", "minLength": 1}
    }
  },
  "curriculum": {
    "type": "object",
    "additionalProperties": false,
    "required": ["agent", "mastered_tier", "frontier_tier", "gaps", "promoted_tier"],
    "properties": {
      "agent": {"type": "string"},
      "mastered_tier": {"type": ["integer", "null"]},
      "frontier_tier": {"type": ["integer", "null"]},
      "gaps": {"type": "array", "items": {"type": "integer"}},
      "promoted_tier": {"type": "integer", "minimum": 1}
    }
  },
  "tier_promoted": {
    "type": "object",
    "additionalProperties": false,
    "required": ["agent", "version", "from_tier", "to_tier", "pass_rate"],
    "properties": {
      "agent": {"type": "string"},
      "version": {"type": "string"},
      "from_tier": {"type": "integer", "minimum": 1},
      "to_tier": {"type": "integer", "minimum": 2},
      "pass_rate": {"type": "object"}
    }
  },
  "saturation": {
    "type": "object",
    "additionalProperties": false,
    "required": ["agent", "saturated", "cases", "share", "hard_case_candidates"],
    "properties": {
      "agent": {"type": "string"},
      "saturated": {"type": "array", "items": {"type": "string"}},
      "cases": {"type": "integer", "minimum": 0},
      "share": {"type": "string"},
      "hard_case_candidates": {"type": "array", "items": {"type": "object"}}
    }
  },
  "outcome": {
    "type": "object",
    "additionalProperties": false,
    "required": ["run_id", "agent", "resolver", "due_at", "resolved_at", "lag_days", "hit", "verdict", "why", "claim", "actual", "confidence", "verdict_recorded"],
    "properties": {
      "run_id": {"type": "string"},
      "agent": {"type": "string"},
      "resolver": {"type": "string"},
      "due_at": {"type": "string"},
      "resolved_at": {"type": "string"},
      "lag_days": {"type": "number"},
      "hit": {"type": "boolean"},
      "verdict": {"type": "string", "enum": ["followed", "overridden", "wrong", "n/a"]},
      "why": {"type": "string", "minLength": 1},
      "claim": {},
      "actual": {},
      "confidence": {"type": ["number", "null"]},
      "verdict_recorded": {"type": "boolean"}
    }
  },
  "reputation": {
    "type": "object",
    "additionalProperties": false,
    "required": ["agent", "cycle", "score", "tier", "previous_tier", "lineage", "edits", "metrics", "why"],
    "properties": {
      "agent": {"type": "string"},
      "cycle": {"type": "string"},
      "score": {"type": ["number", "null"]},
      "tier": {"type": "string"},
      "previous_tier": {"type": "string"},
      "lineage": {"type": "string"},
      "edits": {"type": "integer", "minimum": 0},
      "metrics": {"type": "object"},
      "why": {"type": "string"}
    }
  },
  "probation": {
    "type": "object",
    "additionalProperties": false,
    "required": ["agent", "runs", "passed", "lifted"],
    "properties": {
      "agent": {"type": "string"},
      "runs": {"type": "array", "items": {"type": "string"}},
      "passed": {"type": "integer", "minimum": 0},
      "lifted": {"type": "boolean"}
    }
  },
  "plan": {
    "type": "object",
    "additionalProperties": false,
    "required": ["planner_run_id", "basis", "ranked", "batch", "skips", "planner_suspended"],
    "properties": {
      "planner_run_id": {"type": ["string", "null"]},
      "basis": {"type": "string", "enum": ["value", "none"]},
      "ranked": {"type": "array", "items": {"type": "object"}},
      "batch": {"type": "array", "items": {"type": "object"}},
      "skips": {"type": "array", "items": {"type": "object"}},
      "planner_suspended": {"type": "boolean"}
    }
  },
  "forecast": {
    "type": "object",
    "additionalProperties": false,
    "required": ["role", "made_by", "agent", "metric", "target", "due", "p", "predicted", "ref"],
    "properties": {
      "role": {"type": "string"},
      "made_by": {"type": "string"},
      "agent": {"type": ["string", "null"]},
      "metric": {"type": "string"},
      "target": {"type": ["number", "null"]},
      "due": {"type": ["string", "null"]},
      "p": {"type": "number", "minimum": 0, "maximum": 1},
      "predicted": {"type": "object"},
      "ref": {"type": ["string", "null"]}
    }
  },
  "forecast_resolved": {
    "type": "object",
    "additionalProperties": false,
    "required": ["forecast_event_id", "role", "made_by", "agent", "metric", "hit", "actual", "p", "brier", "errors"],
    "properties": {
      "forecast_event_id": {"type": "string"},
      "role": {"type": "string"},
      "made_by": {"type": "string"},
      "agent": {"type": ["string", "null"]},
      "metric": {"type": "string"},
      "hit": {"type": "boolean"},
      "actual": {"type": ["number", "null"]},
      "p": {"type": "number", "minimum": 0, "maximum": 1},
      "brier": {"type": "number", "minimum": 0, "maximum": 1},
      "errors": {"type": "object"}
    }
  },
  "case_proposed": {
    "type": "object",
    "additionalProperties": false,
    "required": ["curator_run_id", "agent", "case_id", "correct", "difficulty", "attempts", "admitted", "tier", "why"],
    "properties": {
      "curator_run_id": {"type": "string"},
      "agent": {"type": "string"},
      "case_id": {"type": "string"},
      "correct": {"type": ["boolean", "null"]},
      "difficulty": {"type": ["number", "null"]},
      "attempts": {"type": "integer", "minimum": 0},
      "admitted": {"type": "boolean"},
      "tier": {"type": ["integer", "null"], "minimum": 1},
      "why": {"type": "string"}
    }
  },
  "schedule": {
    "type": "object",
    "additionalProperties": false,
    "required": ["job", "kind", "tick", "started_at", "finished_at", "status", "missed", "skipped_reason", "skipped_ticks", "result", "error"],
    "properties": {
      "job": {"type": "string"},
      "kind": {"type": "string", "enum": ["autoloop", "sweep", "triggers", "remediate"]},
      "tick": {"type": "string"},
      "started_at": {"type": "string"},
      "finished_at": {"type": "string"},
      "status": {"type": "string", "enum": ["ran", "skipped", "failed"]},
      "missed": {"type": "boolean"},
      "skipped_reason": {"type": ["string", "null"], "enum": [null, "halted", "window_closed", "beyond_max_catch_up"]},
      "skipped_ticks": {"type": "integer", "minimum": 0},
      "result": {"type": ["object", "null"]},
      "error": {"type": ["string", "null"]}
    }
  },
  "heartbeat": {
    "type": "object",
    "additionalProperties": false,
    "required": ["holder", "expires_at", "reason"],
    "properties": {
      "holder": {"type": "string"},
      "expires_at": {"type": "string"},
      "reason": {"type": "string", "enum": ["acquired", "heartbeat"]}
    }
  },
  "trigger_dispatch": {
    "type": "object",
    "additionalProperties": false,
    "required": ["trigger", "trigger_event_id", "trigger_ledger_index", "agent", "input", "status", "run_id", "why"],
    "properties": {
      "trigger": {"type": "string"},
      "trigger_event_id": {"type": "string"},
      "trigger_ledger_index": {"type": "integer", "minimum": 0},
      "agent": {"type": "string"},
      "input": {"type": ["object", "null"]},
      "status": {"type": "string"},
      "run_id": {"type": ["string", "null"]},
      "why": {"type": ["string", "null"]}
    }
  },
  "trigger": {
    "type": "object",
    "additionalProperties": false,
    "required": ["cause", "cluster", "count", "verdict_event_id", "agent", "status", "refinement_event_id", "adopted", "why", "killed", "judge_suspended"],
    "properties": {
      "cause": {"type": "string", "enum": ["failure_cluster", "operator_override"]},
      "cluster": {"type": "string"},
      "count": {"type": "integer", "minimum": 1},
      "verdict_event_id": {"type": ["string", "null"]},
      "agent": {"type": ["string", "null"]},
      "status": {"type": "string"},
      "refinement_event_id": {"type": ["string", "null"]},
      "adopted": {"type": "boolean"},
      "why": {"type": ["string", "null"]},
      "killed": {"type": "array", "items": {"type": "string"}},
      "judge_suspended": {"type": "boolean"}
    }
  },
  "sizing": {
    "type": "object",
    "required": ["agent", "remaining", "workers", "margin", "budget_usd", "decision", "limit", "arithmetic"],
    "properties": {
      "agent": {"type": "string"},
      "remaining": {"type": "integer", "minimum": 0},
      "workers": {"type": "integer", "minimum": 1},
      "decision": {"type": "string", "enum": ["run", "cap", "refuse", "no_history"]},
      "limit": {"type": ["integer", "null"]},
      "arithmetic": {"type": "string"}
    }
  },
  "sweep_pilot": {
    "type": "object",
    "required": ["agent", "n", "seed", "mean_cost", "remaining", "projected_cost", "pass_rate", "wilson", "projected_wall_s", "decision", "why"],
    "properties": {
      "agent": {"type": "string"},
      "n": {"type": "integer", "minimum": 1},
      "seed": {"type": "string"},
      "projected_cost": {"type": "string"},
      "pass_rate": {"type": "number"},
      "wilson": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
      "decision": {"type": "string", "enum": ["proceed", "stop"]}
    }
  },
  "projection": {
    "type": "object",
    "required": ["agent", "pilot_event_id", "projected_cost", "actual_cost", "cost_error", "projected_pass_rate", "actual_pass_rate", "pass_rate_error", "refinement_event_id", "refinement"],
    "properties": {
      "agent": {"type": "string"},
      "pilot_event_id": {"type": "string"},
      "refinement_event_id": {"type": ["string", "null"]},
      "refinement": {"type": ["object", "null"]}
    }
  },
  "rollout": {
    "type": "object",
    "required": ["agent", "manifest_hash", "tier", "workers", "pass_rate", "mode", "why", "at_completion"],
    "properties": {
      "agent": {"type": "string"},
      "manifest_hash": {"type": "string"},
      "tier": {"type": "integer", "minimum": 0},
      "workers": {"type": "integer", "minimum": 1},
      "pass_rate": {"type": ["number", "null"]},
      "mode": {"type": "string", "enum": ["burn_in", "ramp"]},
      "why": {"type": "string"},
      "at_completion": {"type": "integer", "minimum": 0}
    }
  },
  "version_switch": {
    "type": "object",
    "additionalProperties": false,
    "required": ["agent", "old_hash", "new_hash", "at_completion"],
    "properties": {
      "agent": {"type": "string"},
      "old_hash": {"type": "string"},
      "new_hash": {"type": "string"},
      "at_completion": {"type": "integer", "minimum": 0}
    }
  },
  "scaling": {
    "type": "object",
    "required": ["agent", "workers", "width", "iterations", "pass_rate", "wall_s", "tokens", "cost_usd", "speedup", "efficiency"],
    "properties": {
      "agent": {"type": "string"},
      "workers": {"type": "integer", "minimum": 1},
      "width": {"type": "integer", "minimum": 1},
      "iterations": {"type": "integer", "minimum": 1},
      "pass_rate": {"type": "number"},
      "wall_s": {"type": "number"},
      "tokens": {"type": "integer", "minimum": 0},
      "cost_usd": {"type": "string"},
      "speedup": {"type": ["number", "null"]},
      "efficiency": {"type": ["number", "null"]}
    }
  },
  "worker_calibration": {
    "type": "object",
    "required": ["agent", "ladder", "min_marginal_speedup", "recommended_workers", "saturated_at", "spend_spare_on"],
    "properties": {
      "agent": {"type": "string"},
      "ladder": {"type": "array"},
      "recommended_workers": {"type": "integer", "minimum": 1},
      "saturated_at": {"type": ["integer", "null"]},
      "spend_spare_on": {"type": "string"}
    }
  }
}
