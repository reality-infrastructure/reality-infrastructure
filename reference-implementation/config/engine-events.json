{
  "verdict": {
    "type": "object",
    "additionalProperties": false,
    "required": ["run_id", "agent", "verdict", "reason"],
    "properties": {
      "run_id": {"type": "string"},
      "agent": {"type": "string"},
      "verdict": {"type": "string", "enum": ["followed", "overridden", "wrong", "n/a"]},
      "reason": {"type": "string"}
    }
  },
  "drift": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "shifted", "why", "measured"],
    "properties": {
      "id": {"type": "string"},
      "shifted": {"type": "boolean"},
      "why": {"type": "string"},
      "measured": {"type": "object"}
    }
  },
  "honeypot": {
    "type": "object",
    "additionalProperties": false,
    "required": ["target_run_id", "judge_run_id", "path", "hit", "verdict"],
    "properties": {
      "target_run_id": {"type": "string"},
      "judge_run_id": {"type": "string"},
      "path": {"type": "string"},
      "hit": {"type": "boolean"},
      "verdict": {"type": ["string", "null"]}
    }
  },
  "refinement": {
    "type": "object",
    "additionalProperties": false,
    "required": ["agent", "rung", "file", "old_sha256", "new_sha256", "before_score", "after_score", "adopted", "refiner_run_id", "why"],
    "properties": {
      "agent": {"type": "string"},
      "rung": {"type": "integer", "minimum": 1, "maximum": 2},
      "file": {"type": "string"},
      "old_sha256": {"type": "string"},
      "new_sha256": {"type": "string"},
      "before_score": {"type": "string"},
      "after_score": {"type": "string"},
      "adopted": {"type": "boolean"},
      "refiner_run_id": {"type": "string"},
      "why": {"type": "string"},
      "before_holdout": {"type": ["string", "null"]},
      "after_holdout": {"type": ["string", "null"]},
      "directive_sha256": {"type": ["string", "null"]},
      "addresses_directive": {"type": ["boolean", "null"]}
    }
  },
  "correction": {
    "type": "object",
    "additionalProperties": false,
    "required": ["corrects_event_id", "reason", "payload"],
    "properties": {
      "corrects_event_id": {"type": "string"},
      "reason": {"type": "string"},
      "payload": {"type": "object"}
    }
  },
  "command_blocked": {
    "type": "object",
    "additionalProperties": false,
    "required": ["slot", "adapter", "command", "reason"],
    "properties": {
      "slot": {"type": "string"},
      "adapter": {"type": "string"},
      "command": {"type": "object"},
      "reason": {"type": "string"}
    }
  },
  "latency_breach": {
    "type": "object",
    "additionalProperties": false,
    "required": ["slot", "adapter", "event_id", "latency_seconds", "sla_seconds"],
    "properties": {
      "slot": {"type": "string"},
      "adapter": {"type": "string"},
      "event_id": {"type": "string"},
      "latency_seconds": {"type": "number"},
      "sla_seconds": {"type": "number"}
    }
  },
  "compaction.summary": {
    "type": "object",
    "additionalProperties": false,
    "required": ["agent", "summary", "range", "citations"],
    "properties": {
      "agent": {"type": "string"},
      "summary": {"type": "string"},
      "range": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_observed_at", "to_observed_at", "event_count"],
        "properties": {
          "from_observed_at": {"type": "string"},
          "to_observed_at": {"type": "string"},
          "event_count": {"type": "integer", "minimum": 1}
        }
      },
      "citations": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref"],
          "properties": {"ref": {"type": "string"}, "field": {"type": "string"}}
        }
      }
    }
  },
  "constraint": {"type": "object", "additionalProperties": false, "required": ["week", "top", "next", "metric", "lost_runs", "lost_usd", "previous_top"], "properties": {"week": {"type": "string"}, "top": {"type": ["string", "null"]}, "next": {"type": ["string", "null"]}, "metric": {"type": ["string", "null"]}, "lost_runs": {"type": "integer", "minimum": 0}, "lost_usd": {"type": "string"}, "previous_top": {"type": ["string", "null"]}, "agent": {"type": ["string", "null"]}, "window_top": {"type": ["string", "null"]}}},
  "velocity": {"type": "object", "additionalProperties": false, "required": ["agent", "weeks", "adopted", "gain_per_edit", "cost_per_gain_point", "trend"], "properties": {"agent": {"type": "string"}, "weeks": {"type": "array"}, "adopted": {"type": "integer", "minimum": 0}, "proposed": {"type": "integer", "minimum": 0}, "gain_per_edit": {"type": ["string", "null"]}, "cost_per_gain_point": {"type": ["string", "null"]}, "trend": {"type": "string"}}},
  "cycle": {"type": "object", "additionalProperties": false, "required": ["week", "started", "finished", "cost_usd"], "properties": {"week": {"type": "string"}, "started": {"type": "string"}, "finished": {"type": "string"}, "cost_usd": {"type": "string"}, "runs": {"type": "integer", "minimum": 0}, "hours": {"type": "number"}}},
  "audit_sample": {"type": "object", "additionalProperties": false, "required": ["week", "run_ids", "seed"], "properties": {"week": {"type": "string"}, "run_ids": {"type": "array", "items": {"type": "string"}}, "seed": {"type": "string"}}},
  "blame": {"type": "object", "additionalProperties": false, "required": ["run_id", "origin", "item"], "properties": {"run_id": {"type": "string"}, "agent": {"type": "string"}, "origin": {"type": "string", "enum": ["grounding_missing", "memory_truncated", "tool_error", "prompt", "model", "judge"]}, "item": {"type": "string"}, "against_run_id": {"type": ["string", "null"]}}},
  "attribution": {"type": "object", "additionalProperties": false, "required": ["verdict_event_id", "from_run", "to_run", "field", "kind"], "properties": {"verdict_event_id": {"type": "string"}, "from_run": {"type": "string"}, "to_run": {"type": "string"}, "to_agent": {"type": "string"}, "field": {"type": "string"}, "kind": {"type": "string", "enum": ["credit", "blame"]}, "verdict": {"type": "string"}}},
  "diversity": {"type": "object", "additionalProperties": false, "required": ["agent", "field", "distinct_ratio", "ngram_repeat"], "properties": {"agent": {"type": "string"}, "field": {"type": "string"}, "distinct_ratio": {"type": "number"}, "ngram_repeat": {"type": ["number", "null"]}, "week": {"type": "string"}, "flag": {"type": "string"}}},
  "coverage": {"type": "object", "additionalProperties": false, "required": ["agent", "buckets", "uncovered"], "properties": {"agent": {"type": "string"}, "week": {"type": "string"}, "buckets": {"type": "object"}, "uncovered": {"type": "object"}}},
  "stale_grounding": {"type": "object", "additionalProperties": false, "required": ["agent", "source", "stale_rows", "max_age_days", "week"], "properties": {"agent": {"type": "string"}, "source": {"type": "string"}, "stale_rows": {"type": "array", "items": {"type": "string"}}, "max_age_days": {"type": "integer", "minimum": 0}, "week": {"type": "string"}, "run_id": {"type": "string"}}},
  "synthetic_input": {"type": "object", "additionalProperties": false, "required": ["run_id", "agent", "planner_run_id"], "properties": {"run_id": {"type": "string"}, "agent": {"type": "string"}, "planner_run_id": {"type": "string"}, "input": {"type": "object"}}},
  "vendor_record": {"type": "object", "additionalProperties": false, "required": ["slot", "adapter", "kind"], "properties": {"slot": {"type": "string"}, "adapter": {"type": "string"}, "binding": {"type": "string"}, "kind": {"type": "string", "enum": ["command_ok", "command_error", "ingest_ok", "ingest_error"]}, "detail": {"type": ["string", "null"]}, "trial": {"type": "boolean"}}},
  "binding_promoted": {"type": "object", "additionalProperties": false, "required": ["slot", "binding", "incumbent", "trial_record", "incumbent_record"], "properties": {"slot": {"type": "string"}, "binding": {"type": "string"}, "incumbent": {"type": "string"}, "trial_record": {"type": "object"}, "incumbent_record": {"type": "object"}}},
  "binding_refused": {"type": "object", "additionalProperties": false, "required": ["slot", "binding", "incumbent", "trial_record", "incumbent_record"], "properties": {"slot": {"type": "string"}, "binding": {"type": "string"}, "incumbent": {"type": "string"}, "trial_record": {"type": "object"}, "incumbent_record": {"type": "object"}}},
  "throughput": {"type": "object", "additionalProperties": false, "required": ["workers", "runs_per_hour", "lock_wait_share", "provider_share", "binding"], "properties": {"agent": {"type": "string"}, "workers": {"type": "integer", "minimum": 0}, "runs_per_hour": {"type": "number"}, "items_per_hour": {"type": ["number", "null"]}, "manual_baseline_items": {"type": ["integer", "null"]}, "lock_wait_share": {"type": "number"}, "provider_share": {"type": "number"}, "utilisation": {"type": "number"}, "binding": {"type": "string"}}}
}
