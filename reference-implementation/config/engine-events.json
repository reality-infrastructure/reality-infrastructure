{
  "verdict": {
    "type": "object",
    "additionalProperties": false,
    "required": ["run_id", "agent", "verdict", "reason"],
    "properties": {
      "run_id": {"type": "string"},
      "agent": {"type": "string"},
      "verdict": {"type": "string", "enum": ["followed", "overridden", "wrong", "n/a"]},
      "reason": {"type": "string"}
    }
  },
  "correction": {
    "type": "object",
    "additionalProperties": false,
    "required": ["corrects_event_id", "reason", "payload"],
    "properties": {
      "corrects_event_id": {"type": "string"},
      "reason": {"type": "string"},
      "payload": {"type": "object"}
    }
  },
  "command_blocked": {
    "type": "object",
    "additionalProperties": false,
    "required": ["slot", "adapter", "command", "reason"],
    "properties": {
      "slot": {"type": "string"},
      "adapter": {"type": "string"},
      "command": {"type": "object"},
      "reason": {"type": "string"}
    }
  },
  "latency_breach": {
    "type": "object",
    "additionalProperties": false,
    "required": ["slot", "adapter", "event_id", "latency_seconds", "sla_seconds"],
    "properties": {
      "slot": {"type": "string"},
      "adapter": {"type": "string"},
      "event_id": {"type": "string"},
      "latency_seconds": {"type": "number"},
      "sla_seconds": {"type": "number"}
    }
  },
  "compaction.summary": {
    "type": "object",
    "additionalProperties": false,
    "required": ["agent", "summary", "range", "citations"],
    "properties": {
      "agent": {"type": "string"},
      "summary": {"type": "string"},
      "range": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_observed_at", "to_observed_at", "event_count"],
        "properties": {
          "from_observed_at": {"type": "string"},
          "to_observed_at": {"type": "string"},
          "event_count": {"type": "integer", "minimum": 1}
        }
      },
      "citations": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref"],
          "properties": {"ref": {"type": "string"}, "field": {"type": "string"}}
        }
      }
    }
  }
}
