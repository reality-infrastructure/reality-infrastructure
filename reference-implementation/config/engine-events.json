{
  "verdict": {
    "type": "object",
    "additionalProperties": false,
    "required": ["run_id", "agent", "verdict", "reason"],
    "properties": {
      "run_id": {"type": "string"},
      "agent": {"type": "string"},
      "verdict": {"type": "string", "enum": ["followed", "overridden", "wrong", "n/a"]},
      "reason": {"type": "string"},
      "correction": {"type": "object", "minProperties": 1},
      "expected": {"type": "object", "minProperties": 1},
      "unspecific": {"type": "boolean"},
      "review_seconds": {"type": "number", "minimum": 0},
      "panel": {"type": "array", "items": {"type": "object"}},
      "conflict": {"type": "string"}
    }
  },
  "drift": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "shifted", "why", "measured"],
    "properties": {
      "id": {"type": "string"},
      "shifted": {"type": "boolean"},
      "why": {"type": "string"},
      "measured": {"type": "object"}
    }
  },
  "honeypot": {
    "type": "object",
    "additionalProperties": false,
    "required": ["target_run_id", "judge_run_id", "path", "hit", "verdict"],
    "properties": {
      "target_run_id": {"type": "string"},
      "judge_run_id": {"type": "string"},
      "path": {"type": "string"},
      "hit": {"type": "boolean"},
      "verdict": {"type": ["string", "null"]},
      "tier": {"type": "string"},
      "plant": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2}},
      "restored": {"type": "boolean"}
    }
  },
  "refinement": {
    "type": "object",
    "additionalProperties": false,
    "required": ["agent", "rung", "file", "old_sha256", "new_sha256", "before_score", "after_score", "adopted", "refiner_run_id", "why"],
    "properties": {
      "agent": {"type": "string"},
      "rung": {"type": "integer", "minimum": 1, "maximum": 2},
      "file": {"type": "string"},
      "old_sha256": {"type": "string"},
      "new_sha256": {"type": "string"},
      "before_score": {"type": "string"},
      "after_score": {"type": "string"},
      "adopted": {"type": "boolean"},
      "refiner_run_id": {"type": "string"},
      "why": {"type": "string"},
      "before_holdout": {"type": ["string", "null"]},
      "after_holdout": {"type": ["string", "null"]}
    }
  },
  "correction": {
    "type": "object",
    "additionalProperties": false,
    "required": ["corrects_event_id", "reason", "payload"],
    "properties": {
      "corrects_event_id": {"type": "string"},
      "reason": {"type": "string"},
      "payload": {"type": "object"}
    }
  },
  "command_blocked": {
    "type": "object",
    "additionalProperties": false,
    "required": ["slot", "adapter", "command", "reason"],
    "properties": {
      "slot": {"type": "string"},
      "adapter": {"type": "string"},
      "command": {"type": "object"},
      "reason": {"type": "string"}
    }
  },
  "latency_breach": {
    "type": "object",
    "additionalProperties": false,
    "required": ["slot", "adapter", "event_id", "latency_seconds", "sla_seconds"],
    "properties": {
      "slot": {"type": "string"},
      "adapter": {"type": "string"},
      "event_id": {"type": "string"},
      "latency_seconds": {"type": "number"},
      "sla_seconds": {"type": "number"}
    }
  },
  "compaction.summary": {
    "type": "object",
    "additionalProperties": false,
    "required": ["agent", "summary", "range", "citations"],
    "properties": {
      "agent": {"type": "string"},
      "summary": {"type": "string"},
      "range": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_observed_at", "to_observed_at", "event_count"],
        "properties": {
          "from_observed_at": {"type": "string"},
          "to_observed_at": {"type": "string"},
          "event_count": {"type": "integer", "minimum": 1}
        }
      },
      "citations": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref"],
          "properties": {"ref": {"type": "string"}, "field": {"type": "string"}}
        }
      }
    }
  },
  "judge_disagreement": {"type": "object", "additionalProperties": false, "required": ["run_id", "agent", "panel", "conflict"], "properties": {"run_id": {"type": "string"}, "agent": {"type": "string"}, "panel": {"type": "array", "items": {"type": "object"}}, "conflict": {"type": "string"}}},
  "judge_case": {"type": "object", "additionalProperties": false, "required": ["judge", "case_id", "set", "kind", "run_id", "expected"], "properties": {"judge": {"type": "string"}, "case_id": {"type": "string"}, "set": {"type": "string", "enum": ["golden", "holdout"]}, "kind": {"type": "string"}, "run_id": {"type": "string"}, "expected": {"type": "object"}}},
  "golden_grown": {"type": "object", "additionalProperties": false, "required": ["agent", "case_id", "run_id", "kind"], "properties": {"agent": {"type": "string"}, "case_id": {"type": "string"}, "run_id": {"type": "string"}, "kind": {"type": "string"}}},
  "collusion": {"type": "object", "additionalProperties": false, "required": ["judge", "compared", "agreed", "rate", "suspended"], "properties": {"judge": {"type": "string"}, "compared": {"type": "integer", "minimum": 0}, "agreed": {"type": "integer", "minimum": 0}, "rate": {"type": "number"}, "suspended": {"type": "boolean"}}},
  "trap": {"type": "object", "additionalProperties": false, "required": ["run_id", "agent", "path", "read", "disclosed"], "properties": {"run_id": {"type": "string"}, "agent": {"type": "string"}, "path": {"type": "string"}, "read": {"type": "boolean"}, "disclosed": {"type": "boolean"}}},
  "cheat_rate": {"type": "object", "additionalProperties": false, "required": ["week", "planted", "cheats", "rate", "previous", "halt"], "properties": {"week": {"type": "string"}, "planted": {"type": "integer", "minimum": 0}, "cheats": {"type": "integer", "minimum": 0}, "trap_reads": {"type": "integer", "minimum": 0}, "concealed": {"type": "integer", "minimum": 0}, "honeypot_misses": {"type": "integer", "minimum": 0}, "rate": {"type": "number"}, "previous": {"type": ["number", "null"]}, "halt": {"type": "boolean"}}},
  "anomaly": {"type": "object", "additionalProperties": false, "required": ["run_id", "agent", "report"], "properties": {"run_id": {"type": "string"}, "agent": {"type": "string"}, "report": {"type": "string"}}},
  "review_backlog": {"type": "object", "additionalProperties": false, "required": ["reason", "backlog", "max_backlog"], "properties": {"reason": {"type": "string"}, "path": {"type": "string"}, "backlog": {"type": "integer", "minimum": 0}, "max_backlog": {"type": "integer", "minimum": 0}, "oldest_hours": {"type": ["number", "null"]}, "sla_hours": {"type": ["number", "null"]}}},
  "delegation": {"type": "object", "additionalProperties": false, "required": ["agent", "operator_cost", "agent_cost", "agreement", "decision"], "properties": {"agent": {"type": "string"}, "operator_cost": {"type": ["string", "null"]}, "agent_cost": {"type": ["string", "null"]}, "agreement": {"type": ["number", "null"]}, "decision": {"type": "string"}, "sample_every": {"type": "integer", "minimum": 0}}},
  "monitor": {"type": "object", "additionalProperties": false, "required": ["run_id", "agent", "flag", "why", "monitor_run_id"], "properties": {"run_id": {"type": "string"}, "agent": {"type": "string"}, "flag": {"type": "string", "enum": ["none", "scheming", "grader_gaming", "test_awareness"]}, "why": {"type": "string"}, "monitor_run_id": {"type": "string"}}},
  "monitorability": {"type": "object", "additionalProperties": false, "required": ["week", "candidates", "with_reasoning", "coverage", "monitored", "flagged", "flag_rate", "below_min"], "properties": {"week": {"type": "string"}, "candidates": {"type": "integer", "minimum": 0}, "with_reasoning": {"type": "integer", "minimum": 0}, "coverage": {"type": "number"}, "monitored": {"type": "integer", "minimum": 0}, "flagged": {"type": "integer", "minimum": 0}, "flag_rate": {"type": "number"}, "below_min": {"type": "boolean"}}},
  "intervention": {"type": "object", "additionalProperties": false, "required": ["agent", "runs", "refinement_event_id", "count", "cap"], "properties": {"agent": {"type": "string"}, "runs": {"type": "array", "items": {"type": "string"}}, "refinement_event_id": {"type": "string"}, "count": {"type": "integer", "minimum": 0}, "cap": {"type": "integer", "minimum": 0}}},
  "safeguards": {"type": "object", "additionalProperties": false, "required": ["path", "killed", "judge_suspended", "review_backlog", "over_backlog"], "properties": {"path": {"type": "string"}, "agent": {"type": ["string", "null"]}, "killed": {"type": "array", "items": {"type": "string"}}, "judge_suspended": {"type": "boolean"}, "suspended_by": {"type": ["string", "null"]}, "review_backlog": {"type": "integer", "minimum": 0}, "over_backlog": {"type": "boolean"}}}
}
