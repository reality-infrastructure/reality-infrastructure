{
  "verdict": {
    "type": "object",
    "additionalProperties": false,
    "required": ["run_id", "agent", "verdict", "reason"],
    "properties": {
      "run_id": {"type": "string"},
      "agent": {"type": "string"},
      "verdict": {"type": "string", "enum": ["followed", "overridden", "wrong", "n/a"]},
      "reason": {"type": "string"}
    }
  },
  "drift": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "shifted", "why", "measured"],
    "properties": {
      "id": {"type": "string"},
      "shifted": {"type": "boolean"},
      "why": {"type": "string"},
      "measured": {"type": "object"}
    }
  },
  "honeypot": {
    "type": "object",
    "additionalProperties": false,
    "required": ["target_run_id", "judge_run_id", "path", "hit", "verdict"],
    "properties": {
      "target_run_id": {"type": "string"},
      "judge_run_id": {"type": "string"},
      "path": {"type": "string"},
      "hit": {"type": "boolean"},
      "verdict": {"type": ["string", "null"]}
    }
  },
  "refinement": {
    "type": "object",
    "additionalProperties": false,
    "required": ["agent", "rung", "file", "old_sha256", "new_sha256", "before_score", "after_score", "adopted", "refiner_run_id", "why"],
    "properties": {
      "agent": {"type": "string"},
      "rung": {"type": "integer", "minimum": 1, "maximum": 2},
      "file": {"type": "string"},
      "old_sha256": {"type": "string"},
      "new_sha256": {"type": "string"},
      "before_score": {"type": "string"},
      "after_score": {"type": "string"},
      "adopted": {"type": "boolean"},
      "refiner_run_id": {"type": "string"},
      "why": {"type": "string"},
      "before_holdout": {"type": ["string", "null"]},
      "after_holdout": {"type": ["string", "null"]}
    }
  },
  "correction": {
    "type": "object",
    "additionalProperties": false,
    "required": ["corrects_event_id", "reason", "payload"],
    "properties": {
      "corrects_event_id": {"type": "string"},
      "reason": {"type": "string"},
      "payload": {"type": "object"}
    }
  },
  "command_blocked": {
    "type": "object",
    "additionalProperties": false,
    "required": ["slot", "adapter", "command", "reason"],
    "properties": {
      "slot": {"type": "string"},
      "adapter": {"type": "string"},
      "command": {"type": "object"},
      "reason": {"type": "string"}
    }
  },
  "latency_breach": {
    "type": "object",
    "additionalProperties": false,
    "required": ["slot", "adapter", "event_id", "latency_seconds", "sla_seconds"],
    "properties": {
      "slot": {"type": "string"},
      "adapter": {"type": "string"},
      "event_id": {"type": "string"},
      "latency_seconds": {"type": "number"},
      "sla_seconds": {"type": "number"}
    }
  },
  "compaction.summary": {
    "type": "object",
    "additionalProperties": false,
    "required": ["agent", "summary", "range", "citations"],
    "properties": {
      "agent": {"type": "string"},
      "summary": {"type": "string"},
      "range": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_observed_at", "to_observed_at", "event_count"],
        "properties": {
          "from_observed_at": {"type": "string"},
          "to_observed_at": {"type": "string"},
          "event_count": {"type": "integer", "minimum": 1}
        }
      },
      "citations": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref"],
          "properties": {"ref": {"type": "string"}, "field": {"type": "string"}}
        }
      }
    }
  },
  "rejected_side_effect": {"type": "object", "additionalProperties": false, "required": ["run_id", "agent", "iteration", "candidate", "reason", "effects"], "properties": {"run_id": {"type": "string"}, "agent": {"type": "string"}, "iteration": {"type": "integer"}, "candidate": {"type": "integer"}, "reason": {"type": "string"}, "effects": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["tool", "effect", "args"], "properties": {"tool": {"type": "string"}, "effect": {"type": "string"}, "args": {"type": "object"}}}}}},
  "risk_block": {"type": "object", "additionalProperties": false, "required": ["run_id", "agent", "slot", "rule", "attempted", "cap", "command", "command_sha256"], "properties": {"run_id": {"type": ["string", "null"]}, "agent": {"type": ["string", "null"]}, "slot": {"type": "string"}, "rule": {"type": "string", "enum": ["ruin_halt", "max_external_per_run", "max_external_per_cycle", "stake_undeclared", "max_exposure", "stake", "irreversible_needs_approval"]}, "attempted": {"type": ["number", "null"]}, "cap": {"type": ["number", "null"]}, "command": {"type": "object"}, "command_sha256": {"type": "string"}}},
  "approval": {"type": "object", "additionalProperties": false, "required": ["risk_block_event_id", "command_sha256", "reason"], "properties": {"risk_block_event_id": {"type": "string"}, "command_sha256": {"type": "string"}, "reason": {"type": "string"}}},
  "command_sent": {"type": "object", "additionalProperties": false, "required": ["run_id", "agent", "slot", "adapter", "command_sha256", "at_risk", "accepted", "vendor_ref", "approval_event_id"], "properties": {"run_id": {"type": ["string", "null"]}, "agent": {"type": ["string", "null"]}, "slot": {"type": "string"}, "adapter": {"type": "string"}, "command_sha256": {"type": "string"}, "at_risk": {"type": ["number", "null"]}, "accepted": {"type": "boolean"}, "vendor_ref": {"type": ["string", "null"]}, "approval_event_id": {"type": ["string", "null"]}}},
  "loss": {"type": "object", "additionalProperties": false, "required": ["agent", "slot", "amount", "run_id", "why"], "properties": {"agent": {"type": "string"}, "slot": {"type": "string"}, "amount": {"type": "number", "minimum": 0}, "run_id": {"type": ["string", "null"]}, "why": {"type": "string"}}},
  "ruin_halt": {"type": "object", "additionalProperties": false, "required": ["agent", "slot", "loss", "threshold", "loss_event_id"], "properties": {"agent": {"type": "string"}, "slot": {"type": "string"}, "loss": {"type": "number"}, "threshold": {"type": "number"}, "loss_event_id": {"type": "string"}}},
  "ruin_lift": {"type": "object", "additionalProperties": false, "required": ["agent", "ruin_halt_event_id", "reason"], "properties": {"agent": {"type": "string"}, "ruin_halt_event_id": {"type": "string"}, "reason": {"type": "string"}}},
  "message": {"type": "object", "additionalProperties": false, "required": ["group", "from_run_id", "from_part", "to_part", "text"], "properties": {"group": {"type": "string"}, "from_run_id": {"type": "string"}, "from_part": {"type": "integer"}, "to_part": {"type": "string"}, "text": {"type": "string"}}},
  "disagreement": {"type": "object", "additionalProperties": false, "required": ["run_id", "agent", "fields", "candidates", "reconciled"], "properties": {"run_id": {"type": "string"}, "agent": {"type": "string"}, "fields": {"type": "array", "items": {"type": "string"}}, "candidates": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["key", "values_sha256"], "properties": {"key": {"type": "string"}, "values_sha256": {"type": "string"}}}}, "reconciled": {"type": ["boolean", "null"]}}},
  "scratch": {"type": "object", "additionalProperties": false, "required": ["scope", "run_id", "agent", "text"], "properties": {"scope": {"type": "string"}, "run_id": {"type": "string"}, "agent": {"type": "string"}, "text": {"type": "string"}}},
  "fault": {"type": "object", "additionalProperties": false, "required": ["run_id", "target", "kind", "call_index", "detail"], "properties": {"run_id": {"type": "string"}, "target": {"type": "string"}, "kind": {"type": "string", "enum": ["error", "stale", "altered"]}, "call_index": {"type": "integer"}, "detail": {"type": "string"}}},
  "fault_soak": {"type": "object", "additionalProperties": false, "required": ["agent", "runs", "faulted_runs", "failed_closed", "succeeded_faulted", "rate", "kinds", "run_ids"], "properties": {"agent": {"type": "string"}, "runs": {"type": "integer"}, "faulted_runs": {"type": "integer"}, "failed_closed": {"type": "integer"}, "succeeded_faulted": {"type": "integer"}, "rate": {"type": "number"}, "kinds": {"type": "array", "items": {"type": "string"}}, "run_ids": {"type": "array", "items": {"type": "string"}}}}
}
