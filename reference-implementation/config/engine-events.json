{
  "verdict": {
    "type": "object",
    "additionalProperties": false,
    "required": ["run_id", "agent", "verdict", "reason"],
    "properties": {
      "run_id": {"type": "string"},
      "agent": {"type": "string"},
      "verdict": {"type": "string", "enum": ["followed", "overridden", "wrong", "n/a"]},
      "reason": {"type": "string"}
    }
  },
  "drift": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "shifted", "why", "measured"],
    "properties": {
      "id": {"type": "string"},
      "shifted": {"type": "boolean"},
      "why": {"type": "string"},
      "measured": {"type": "object"}
    }
  },
  "honeypot": {
    "type": "object",
    "additionalProperties": false,
    "required": ["target_run_id", "judge_run_id", "path", "hit", "verdict"],
    "properties": {
      "target_run_id": {"type": "string"},
      "judge_run_id": {"type": "string"},
      "path": {"type": "string"},
      "hit": {"type": "boolean"},
      "verdict": {"type": ["string", "null"]}
    }
  },
  "refinement": {
    "type": "object",
    "additionalProperties": false,
    "required": ["agent", "rung", "file", "old_sha256", "new_sha256", "before_score", "after_score", "adopted", "refiner_run_id", "why"],
    "properties": {
      "agent": {"type": "string"},
      "rung": {"type": "integer", "minimum": 1, "maximum": 2},
      "file": {"type": "string"},
      "old_sha256": {"type": "string"},
      "new_sha256": {"type": "string"},
      "before_score": {"type": "string"},
      "after_score": {"type": "string"},
      "adopted": {"type": "boolean"},
      "refiner_run_id": {"type": "string"},
      "why": {"type": "string"},
      "before_holdout": {"type": ["string", "null"]},
      "after_holdout": {"type": ["string", "null"]}
    }
  },
  "correction": {
    "type": "object",
    "additionalProperties": false,
    "required": ["corrects_event_id", "reason", "payload"],
    "properties": {
      "corrects_event_id": {"type": "string"},
      "reason": {"type": "string"},
      "payload": {"type": "object"}
    }
  },
  "command_blocked": {
    "type": "object",
    "additionalProperties": false,
    "required": ["slot", "adapter", "command", "reason"],
    "properties": {
      "slot": {"type": "string"},
      "adapter": {"type": "string"},
      "command": {"type": "object"},
      "reason": {"type": "string"}
    }
  },
  "latency_breach": {
    "type": "object",
    "additionalProperties": false,
    "required": ["slot", "adapter", "event_id", "latency_seconds", "sla_seconds"],
    "properties": {
      "slot": {"type": "string"},
      "adapter": {"type": "string"},
      "event_id": {"type": "string"},
      "latency_seconds": {"type": "number"},
      "sla_seconds": {"type": "number"}
    }
  },
  "compaction.summary": {
    "type": "object",
    "additionalProperties": false,
    "required": ["agent", "summary", "range", "citations"],
    "properties": {
      "agent": {"type": "string"},
      "summary": {"type": "string"},
      "range": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_observed_at", "to_observed_at", "event_count"],
        "properties": {
          "from_observed_at": {"type": "string"},
          "to_observed_at": {"type": "string"},
          "event_count": {"type": "integer", "minimum": 1}
        }
      },
      "citations": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref"],
          "properties": {"ref": {"type": "string"}, "field": {"type": "string"}}
        }
      }
    }
  }
}
