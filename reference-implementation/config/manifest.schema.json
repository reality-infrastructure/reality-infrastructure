{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "role", "version", "model", "grounding", "tools", "memory", "loop", "safeguards"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "role": {"type": "string", "enum": ["orchestrator", "specialist", "worker"]},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "system_prompt_file"],
      "properties": {
        "provider": {"type": "string", "enum": ["anthropic", "openai_compat", "local"]},
        "name": {"type": "string", "minLength": 1},
        "system_prompt_file": {"type": "string", "minLength": 1},
        "max_tokens": {"type": "integer", "minimum": 256, "maximum": 128000, "default": 16000},
        "variants": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "system_prompt_file": {"type": "string", "minLength": 1},
              "tool_overrides": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "grounding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources"],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "ref"],
            "properties": {
              "kind": {"type": "string", "enum": ["table", "file", "event_query", "agent_output"]},
              "ref": {"type": "string", "minLength": 1},
              "limit": {"type": "integer", "minimum": 1, "maximum": 5000}
            }
          }
        }
      }
    },
    "tools": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["working", "long_term", "compaction"],
      "properties": {
        "working": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_tokens"],
          "properties": {"max_tokens": {"type": "integer", "minimum": 1000}}
        },
        "long_term": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["event_queries", "prior_outputs"],
              "properties": {
                "event_queries": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "entity_type": {"type": "string"},
                      "event_type": {"type": "string"},
                      "limit": {"type": "integer", "minimum": 1, "maximum": 500, "default": 50}
                    }
                  }
                },
                "prior_outputs": {"type": "integer", "minimum": 0, "maximum": 50}
              }
            }
          ]
        },
        "compaction": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["after_days", "summary_agent"],
              "properties": {
                "after_days": {"type": "integer", "minimum": 1},
                "summary_agent": {"type": "string", "minLength": 1}
              }
            }
          ]
        }
      }
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_iterations": {"type": "integer", "minimum": 1, "maximum": 20},
        "search_width": {"type": "integer", "minimum": 1, "maximum": 8},
        "stop_when": {"type": "string", "enum": ["all_guardrails_pass", "verifier_certified", "iterations_exhausted"]}
      }
    },
    "safeguards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_schema", "guardrails", "verifier"],
      "properties": {
        "output_schema": {"type": "string", "minLength": 1},
        "guardrails": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "verifier": {"type": ["string", "null"]},
        "confidence_field": {"type": "string"},
        "max_output_bytes": {"type": "integer", "minimum": 1024, "default": 65536}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items_evaluated_field": {"type": "string"}
      }
    }
  }
}
