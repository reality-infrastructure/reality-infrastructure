{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "disprover output",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_event_id", "verdict", "checks", "failure_modes", "reversal_trigger", "fallback", "de_risking_move", "verdict_event", "citations", "confidence"],
  "properties": {
    "request_event_id": {"type": "string", "minLength": 1},
    "verdict": {"type": "string", "enum": ["PROCEED", "VERIFY-FIRST", "RESTRUCTURE", "HOLD"]},
    "checks": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "holds", "evidence"],
        "properties": {
          "id": {"type": "string", "enum": ["G1", "G2", "G3", "G4", "G5", "G6", "G7", "G8"]},
          "holds": {"type": "boolean"},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "failure_modes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["story", "root_cause", "self_deception"],
        "properties": {
          "story": {"type": "string", "minLength": 1},
          "root_cause": {"type": "string", "minLength": 1},
          "self_deception": {"type": "boolean"}
        }
      }
    },
    "reversal_trigger": {"type": "string", "minLength": 1},
    "fallback": {"type": "string", "minLength": 1},
    "de_risking_move": {"type": "string", "minLength": 1},
    "verdict_event": {"type": "string", "minLength": 1},
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref"],
        "properties": {"ref": {"type": "string"}, "field": {"type": "string"}}
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
