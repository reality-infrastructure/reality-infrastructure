{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "refiner edit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent",
    "rung",
    "file",
    "old",
    "new",
    "why",
    "confidence"
  ],
  "properties": {
    "agent": {
      "type": "string"
    },
    "rung": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "file": {
      "type": [
        "string",
        "null"
      ]
    },
    "old": {
      "type": "string"
    },
    "new": {
      "type": "string"
    },
    "why": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
