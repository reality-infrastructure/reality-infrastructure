{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "refiner edit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent",
    "rung",
    "file",
    "old",
    "new",
    "why",
    "confidence"
  ],
  "properties": {
    "agent": {
      "type": "string"
    },
    "rung": {
      "type": "integer",
      "enum": [
        1,
        2
      ]
    },
    "file": {
      "type": [
        "string",
        "null"
      ]
    },
    "old": {
      "type": "string"
    },
    "new": {
      "type": "string"
    },
    "why": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "forecast": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p_adopt", "golden_delta", "holdout_delta", "target"],
      "properties": {
        "p_adopt": {"type": "number", "minimum": 0, "maximum": 1},
        "golden_delta": {"type": "number"},
        "holdout_delta": {"type": ["number", "null"]},
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metric", "value", "due", "p_hit"],
          "properties": {
            "metric": {"type": "string"},
            "value": {"type": "number"},
            "due": {"type": "string"},
            "p_hit": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "addresses_directive": {
      "type": "boolean"
    }
  }
}
